# Browser-safe values only. Copy to frontend/.env.local for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-browser-safe-key

# For Vercel, replace the API origin with https://your-modal-api.modal.run.
# Set all three in Vercel before building; changes require a new build.
# NEXT_PUBLIC_API_URL is a legacy alias; use NEXT_PUBLIC_API_BASE_URL only.
# Never copy the root backend .env into this directory or Vercel.

# ==============================================================================
# AI Tutor Assistant - Environment Configuration Example
# Copy this file to .env (root or backend/.env).
# For frontend/.env.local, copy frontend/.env.example instead (public values only).
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Variables (Browser Accessible - prefixed with NEXT_PUBLIC_)
# Docker Compose passes only these public values to the frontend build because
# Next.js embeds NEXT_PUBLIC_* configuration into browser JavaScript.
# Never put backend credentials in NEXT_PUBLIC_* variables.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# Backend & Database Configuration (Server-Only - NEVER expose to browser)
# ------------------------------------------------------------------------------
PROJECT_NAME="AI Tutor Assistant API"
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Supabase Credentials (Server-side)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_AUTH_TIMEOUT_SECONDS=5
# Compose overrides Auth verification to 15 seconds and retries one transport failure.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-do-not-expose
# Required by the Compose ingestion worker for service-only queue RPCs.
# Use the same dedicated Supabase Dev project as DB, Storage, and browser Auth.

# Direct or Supavisor session-mode PostgreSQL connection (persistent backend).
# FastAPI switches each SQLAlchemy transaction to role `authenticated` and sets
# claims from the verified user, so Supabase RLS applies to backend queries too.
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Preferred production name; DATABASE_URL remains supported for compatibility.
SUPABASE_DB_URL=postgresql+asyncpg://postgres:your-db-password@localhost:5432/postgres
# DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@localhost:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
RLS_TEST_DATABASE_URL=postgresql+asyncpg://postgres:...@.../postgres

# Optional Phase 5 system dependencies (server-side)
# Install Tesseract and its English + Vietnamese traineddata files for scanned PDFs/images.
TESSERACT_CMD=tesseract
TESSERACT_LANGUAGES=vie+eng
# LibreOffice is required only when processing legacy binary .doc uploads.
LIBREOFFICE_CMD=soffice
LIBREOFFICE_TIMEOUT_SECONDS=60

# Phase 6 BGE-M3 Embeddings & pgvector (Server-side)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu
# EMBEDDING_MODEL_CACHE_DIR=./cache/models
EMBEDDING_NORMALIZE=True
AUTO_EMBED_AFTER_INGESTION=True
PREWARM_MODELS=False
# Compose mounts a persistent model-cache volume at /models and overrides both
# devices to cpu and model cache paths to /models/huggingface for backend/worker.

# Phase 7 Hybrid Retrieval + Reranking (Server-side)
DENSE_TOP_K=25
LEXICAL_TOP_K=25
RRF_K=60
CANDIDATE_POOL_SIZE=30
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=16
RERANKER_DEVICE=cpu
RERANK_TOP_K=5
RELEVANCE_THRESHOLD=0.35
RETRIEVAL_ROUTING_MODE=adaptive

# Phase 8 LLM Generation (Gemini) (Server-side - NEVER expose to frontend)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=medium
LLM_MAX_OUTPUT_TOKENS=2048
LLM_STREAMING_TIMEOUT_SECONDS=60.0

PREWARM_MODELS=true

# Compose overrides this development-only profile; leave false for production/Modal.
LOCAL_SHARED_MODELS=false
LOCAL_MODEL_MAX_TOKENS=512
LOCAL_MODEL_API_URL=http://backend:8000

WEB_SEARCH_FALLBACK_ENABLED=true
# Minimum top-1 rerank score for retrieved evidence to be considered "answerable".
# Chunks scoring between RELEVANCE_THRESHOLD (0.35) and this value indicate
# topically adjacent but non-answerable evidence → web fallback is triggered.
MIN_ANSWERABLE_RERANK_SCORE=0.55
